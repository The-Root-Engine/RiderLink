<idea-plugin>
    <id>com.rootengine.riderlink</id>
    <name>RiderLink</name>
    <vendor>RootEngine</vendor>
    <description><![CDATA[
    Rider Link Plugin for Root Engine
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.cidr.lang</depends>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider 
            language="ObjectiveC" 
            implementationClass="com.rootengine.riderlink.ColorPreviewMarkerProvider"/>
    </extensions>
</idea-plugin>
